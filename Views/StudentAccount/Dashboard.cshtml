@model studentmanagement.Models.Student

@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Student Dashboard";

    var studentImage = string.IsNullOrWhiteSpace(Model.ProfileImage)
        ? "/images/default-user.png"
        : Model.ProfileImage;
}

<div class="px-4 py-3">

    <!-- Welcome Card -->
    <div class="card bg-primary text-white shadow border-0 mb-4 mt-3">

        <div class="card-body d-flex justify-content-between align-items-center">

            <div>
                <h2 class="fw-bold mb-2">
                    Welcome, @Model.Name 👋
                </h2>

                <p class="mb-0">
                    Student Dashboard
                </p>
            </div>


            <img src="@studentImage"
                 width="85"
                 height="85"
                 class="rounded-circle border border-3 border-white"
                 style="object-fit:cover;" />

        </div>

    </div>


    <div class="row g-4">


        <!-- Left Side -->
        <div class="col-lg-8">

            <div class="card shadow border-0">

                <div class="card-header bg-white">
                    <h4 class="mb-0">
                        Personal Information
                    </h4>
                </div>


                <div class="card-body">

                    <table class="table table-bordered mb-0">

                        <tr>
                            <th width="220">Student Code</th>
                            <td>@Model.StudentCode</td>
                        </tr>


                        <tr>
                            <th>Name</th>
                            <td>@Model.Name</td>
                        </tr>


                        <tr>
                            <th>Email</th>
                            <td>@Model.Email</td>
                        </tr>


                        <tr>
                            <th>Phone</th>
                            <td>@Model.PhoneNumber</td>
                        </tr>


                        <tr>
                            <th>Course</th>
                            <td>@Model.Course</td>
                        </tr>


                        <tr>
                            <th>Batch</th>
                            <td>
                                @(string.IsNullOrWhiteSpace(Model.Batch)
                                ? "Not Assigned"
                                : Model.Batch)
                            </td>
                        </tr>


                        <tr>
                            <th>Section</th>
                            <td>
                                @(string.IsNullOrWhiteSpace(Model.Section)
                                ? "Not Assigned"
                                : Model.Section)
                            </td>
                        </tr>


                        <tr>
                            <th>Registration Date</th>
                            <td>
                                @Model.RegistrationDate.ToString("dd MMM yyyy")
                            </td>
                        </tr>


                    </table>

                </div>

            </div>

        </div>



        <!-- Right Side -->
        <div class="col-lg-4">


            <div class="card shadow border-0 mb-4">

                <div class="card-body text-center">

                    <h4>
                        Account Status
                    </h4>


                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success fs-6">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6">
                            Inactive
                        </span>
                    }


                </div>

            </div>



            <div class="card shadow border-0 mb-4">


                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        Student QR Code
                    </h5>
                </div>


                <div class="card-body text-center">


                    <img src="@Url.Action("GenerateQr", "Students", new { id = Model.Id })"
                         class="img-fluid border rounded p-2"
                         style="max-width:220px;" />


                    <div class="mt-3">

                        <a asp-controller="Students"
                           asp-action="PublicProfile"
                           asp-route-token="@Model.PublicToken"
                           target="_blank"
                           class="btn btn-success w-100">

                            View Public Profile

                        </a>

                    </div>


                </div>


            </div>



        </div>


    </div>


</div>
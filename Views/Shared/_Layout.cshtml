<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Student Management System</title>

    <link rel="shortcut icon" type="image/png" href="~/assets/images/logos/favicon.png" />
    <link rel="stylesheet" href="~/assets/css/styles.min.css" />
</head>

<body>

    <div class="page-wrapper" id="main-wrapper"
         data-layout="vertical"
         data-navbarbg="skin6"
         data-sidebartype="full"
         data-sidebar-position="fixed"
         data-header-position="fixed">

        <!-- Sidebar Start -->
        <aside class="left-sidebar">

            <div>

                <!-- Logo -->
                <div class="brand-logo d-flex align-items-center justify-content-between">

                    <a href="/" class="text-nowrap logo-img">
                        <img src="~/assets/images/logos/logo.svg" alt="Logo" />
                    </a>

                    <div class="close-btn d-xl-none d-block sidebartoggler cursor-pointer"
                         id="sidebarCollapse">
                        <i class="ti ti-x fs-6"></i>
                    </div>

                </div>

                <!-- Sidebar Navigation -->
                <nav class="sidebar-nav scroll-sidebar" data-simplebar="">

                    <ul id="sidebarnav">

                        <li class="nav-small-cap">
                            <span class="hide-menu">
                                Main Menu
                            </span>
                        </li>

                        <!-- Dashboard -->
                        <li class="sidebar-item">
                            <a class="sidebar-link"
                               asp-controller="Home"
                               asp-action="Index">

                                <span>
                                    <i class="ti ti-dashboard"></i>
                                </span>

                                <span class="hide-menu">
                                    Dashboard
                                </span>

                            </a>
                        </li>

                        <!-- Students -->
                        <li class="sidebar-item">
                            <a class="sidebar-link"
                               asp-controller="Students"
                               asp-action="Index">

                                <span>
                                    <i class="ti ti-users"></i>
                                </span>

                                <span class="hide-menu">
                                    Students
                                </span>

                            </a>
                        </li>

                        <!-- Add Student -->
                        <li class="sidebar-item">
                            <a class="sidebar-link"
                               asp-controller="Students"
                               asp-action="Create">

                                <span>
                                    <i class="ti ti-user-plus"></i>
                                </span>

                                <span class="hide-menu">
                                    Add Student
                                </span>

                            </a>
                        </li>

                        <!-- Courses -->
                        <li class="sidebar-item">
                            <a class="sidebar-link"
                               asp-controller="Courses"
                               asp-action="Index">

                                <span>
                                    <i class="ti ti-book"></i>
                                </span>

                                <span class="hide-menu">
                                    Courses
                                </span>

                            </a>
                        </li>

                        <!-- Add Course -->
                        <li class="sidebar-item">
                            <a class="sidebar-link"
                               asp-controller="Courses"
                               asp-action="Create">

                                <span>
                                    <i class="ti ti-book-upload"></i>
                                </span>

                                <span class="hide-menu">
                                    Add Course
                                </span>

                            </a>
                        </li>

                        <!-- Batches -->
                        <li class="sidebar-item">
                            <a class="sidebar-link"
                               asp-controller="Batches"
                               asp-action="Index">

                                <span>
                                    <i class="ti ti-layers-linked"></i>
                                </span>

                                <span class="hide-menu">
                                    Batches
                                </span>

                            </a>
                        </li>

                        <!-- Add Batch -->
                        <li class="sidebar-item">
                            <a class="sidebar-link"
                               asp-controller="Batches"
                               asp-action="Create">

                                <span>
                                    <i class="ti ti-plus"></i>
                                </span>

                                <span class="hide-menu">
                                    Add Batch
                                </span>

                            </a>
                        </li>

                        <!-- Sections -->
                        <li class="sidebar-item">
                            <a class="sidebar-link"
                               asp-controller="Sections"
                               asp-action="Index">

                                <span>
                                    <i class="ti ti-layout-grid"></i>
                                </span>

                                <span class="hide-menu">
                                    Sections
                                </span>

                            </a>
                        </li>

                        <!-- Add Section -->
                        <li class="sidebar-item">
                            <a class="sidebar-link"
                               asp-controller="Sections"
                               asp-action="Create">

                                <span>
                                    <i class="ti ti-square-rounded-plus"></i>
                                </span>

                                <span class="hide-menu">
                                    Add Section
                                </span>

                            </a>
                        </li>

                    </ul>

                </nav>

            </div>

        </aside>
        <!-- Sidebar End -->
        <!-- Main Wrapper -->
        <div class="body-wrapper">

            <!-- Header -->
            <header class="app-header">

                <nav class="navbar navbar-expand-lg navbar-light">

                    <ul class="navbar-nav">

                        <li class="nav-item d-block d-xl-none">

                            <a class="nav-link sidebartoggler"
                               id="headerCollapse"
                               href="javascript:void(0)">

                                <i class="ti ti-menu-2"></i>

                            </a>

                        </li>

                    </ul>

                    <div class="navbar-collapse justify-content-end px-0">

                        <ul class="navbar-nav flex-row ms-auto align-items-center">

                            <li class="nav-item me-3">
                                <span class="fw-semibold text-primary">
                                    Welcome, Admin
                                </span>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Account"
                                   asp-action="Logout"
                                   class="btn btn-danger btn-sm">

                                    <i class="ti ti-logout"></i>
                                    Logout

                                </a>
                            </li>

                        </ul>

                    </div>

                </nav>

            </header>

            <!-- Page Content -->
            <div class="body-wrapper-inner">

                <div class="container-fluid">

                    @RenderBody()

                </div>

            </div>

        </div>

    </div>

    <!-- Scripts -->
    <script src="~/assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="~/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/sidebarmenu.js"></script>
    <script src="~/assets/js/app.min.js"></script>
    <script src="~/assets/libs/apexcharts/dist/apexcharts.min.js"></script>
    <script src="~/assets/libs/simplebar/dist/simplebar.js"></script>

    <!-- Iconify Icons -->
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.8/dist/iconify-icon.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
@using studentmanagement.Models

@{
    ViewData["Title"] = "Dashboard";
    var recentStudents = ViewBag.RecentStudents as List<Student>;
}

<div class="card shadow-sm border-0 mb-4 bg-primary text-white">
    <div class="card-body d-flex justify-content-between align-items-center">

        <div>
            <h2 class="fw-bold mb-1">Welcome, Admin 👋</h2>
            <p class="mb-0">
                Manage students, batches and sections from one place.
            </p>
        </div>

        <div class="text-end">
            <h4 id="currentDate"></h4>
            <h5 id="currentTime"></h5>
        </div>

    </div>
</div>

<!-- Statistics -->
<div class="row">

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card border-0 shadow bg-primary text-white">
            <div class="card-body text-center">
                <i class="ti ti-users fs-1"></i>
                <h5 class="mt-2">Students</h5>
                <h2>@ViewBag.TotalStudents</h2>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card border-0 shadow bg-success text-white">
            <div class="card-body text-center">
                <i class="ti ti-package fs-1"></i>
                <h5 class="mt-2">Batches</h5>
                <h2>@ViewBag.TotalBatches</h2>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card border-0 shadow bg-info text-white">
            <div class="card-body text-center">
                <i class="ti ti-building fs-1"></i>
                <h5 class="mt-2">Sections</h5>
                <h2>@ViewBag.TotalSections</h2>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card border-0 shadow bg-danger text-white">
            <div class="card-body text-center">
                <i class="ti ti-alert-triangle fs-1"></i>
                <h5 class="mt-2">Pending</h5>
                <h2>@ViewBag.PendingAssignments</h2>
            </div>
        </div>
    </div>

</div>

<div class="row">

    <div class="col-md-6 mb-4">
        <div class="card shadow border-0">
            <div class="card-body text-center">
                <i class="ti ti-man fs-1 text-primary"></i>
                <h5 class="mt-2">Male Students</h5>
                <h2>@ViewBag.MaleStudents</h2>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card shadow border-0">
            <div class="card-body text-center">
                <i class="ti ti-woman fs-1 text-danger"></i>
                <h5 class="mt-2">Female Students</h5>
                <h2>@ViewBag.FemaleStudents</h2>
            </div>
        </div>
    </div>

</div>

<div class="row">

    <!-- Quick Actions -->
    <div class="col-lg-4 mb-4">

        <div class="card shadow border-0 h-100">

            <div class="card-header bg-white">

                <h5 class="mb-0">
                    <i class="ti ti-bolt text-warning"></i>
                    Quick Actions
                </h5>

            </div>

            <div class="card-body d-flex flex-column align-items-center justify-content-center">

                <a asp-controller="Students"
                   asp-action="Create"
                   class="btn btn-primary rounded-pill mb-3"
                   style="width:220px;">

                    <i class="ti ti-user-plus me-2"></i>
                    Add Student

                </a>

                <a asp-controller="Batches"
                   asp-action="Create"
                   class="btn btn-success rounded-pill mb-3"
                   style="width:220px;">

                    <i class="ti ti-package me-2"></i>
                    Add Batch

                </a>

                <a asp-controller="Sections"
                   asp-action="Create"
                   class="btn btn-info text-white rounded-pill mb-3"
                   style="width:220px;">

                    <i class="ti ti-building me-2"></i>
                    Add Section

                </a>

                <a asp-controller="Students"
                   asp-action="Index"
                   class="btn btn-dark rounded-pill"
                   style="width:220px;">

                    <i class="ti ti-list me-2"></i>
                    View Students

                </a>

            </div>

        </div>

    </div>

    <!-- Recent Students -->
    <div class="col-lg-8 mb-4">

        <div class="card shadow">

            <div class="card-header">
                <h5 class="mb-0">
                    🆕 Recently Registered Students
                </h5>
            </div>

            <div class="card-body">

                @if (recentStudents != null && recentStudents.Any())
                {
                    <div class="row">

                        @foreach (var student in recentStudents)
                        {
                            <div class="col-md-6 col-xl-4 mb-3">

                                <div class="card border-0 shadow-sm h-100">

                                    <div class="card-body text-center">

                                        @{
                                            var studentImage = string.IsNullOrWhiteSpace(student.ProfileImage)
                                                ? "/images/default-user.png"
                                                : student.ProfileImage;
                                        }

                                        <img src="@studentImage"
                                             width="75"
                                             height="75"
                                             class="rounded-circle border border-3 border-primary mb-3"
                                             style="object-fit:cover;" />

                                        <h5 class="fw-bold mb-1">
                                            @student.Name
                                        </h5>

                                        <small class="text-muted">
                                            @student.StudentCode
                                        </small>

                                        <hr />

                                        <p class="mb-1">
                                            <strong>Batch:</strong>
                                            @(string.IsNullOrWhiteSpace(student.Batch)
                                                ? "Not Assigned"
                                                : student.Batch)
                                        </p>

                                        <p class="mb-1">
                                            <strong>Section:</strong>
                                            @(string.IsNullOrWhiteSpace(student.Section)
                                                ? "Not Assigned"
                                                : student.Section)
                                        </p>

                                        <small class="text-muted">
                                            Registered:
                                            @student.RegistrationDate.ToString("dd MMM yyyy")
                                        </small>

                                        <div class="mt-3">

                                            <a asp-controller="Students"
                                               asp-action="Details"
                                               asp-route-id="@student.Id"
                                               class="btn btn-sm btn-primary">

                                                <i class="ti ti-eye"></i>
                                                View Profile

                                            </a>

                                        </div>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        No students available.
                    </div>
                }

            </div>

        </div>

        <!-- Students By Batch Chart -->
        <div class="card shadow mt-4 border-0">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="ti ti-chart-donut text-primary"></i>
                    Students By Batch
                </h5>
            </div>

            <div class="card-body">

                <div id="batchChart" style="height:400px;"></div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        var options = {
            series: @(Html.Raw(ViewBag.BatchChart ?? "[]")),
            chart: {
                type: 'donut',
                height: 400
            },
            labels: @(Html.Raw(ViewBag.BatchLabels ?? "[]")),
            legend: {
                position: 'bottom'
            },
            dataLabels: {
                enabled: true
            },
            responsive: [{
                breakpoint: 768,
                options: {
                    chart: {
                        height: 300
                    },
                    legend: {
                        position: 'bottom'
                    }
                }
            }]
        };

        new ApexCharts(
            document.querySelector("#batchChart"),
            options
        ).render();

        function updateClock() {
            const now = new Date();
            document.getElementById("currentDate").innerHTML = now.toLocaleDateString();
            document.getElementById("currentTime").innerHTML = now.toLocaleTimeString();
        }

        updateClock();
        setInterval(updateClock, 1000);
    </script>
}
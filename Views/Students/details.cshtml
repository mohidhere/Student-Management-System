@model studentmanagement.Models.Student

@{
    ViewData["Title"] = "Student Profile";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">

            <h3 class="mb-0">
                Student Profile
            </h3>

        </div>

        <div class="card-body">

            <div class="row">

                <!-- Left Side -->
                <div class="col-md-4 text-center">

                    @if (!string.IsNullOrEmpty(Model.ProfileImage))
                    {
                        <img src="@Model.ProfileImage"
                             class="rounded-circle border shadow"
                             width="220"
                             height="220"
                             style="object-fit:cover;" />
                    }
                    else
                    {
                        <img src="/images/default-user.png"
                             class="rounded-circle border shadow"
                             width="220"
                             height="220"
                             style="object-fit:cover;" />
                    }

                    <h3 class="mt-3">
                        @Model.Name
                    </h3>

                    <span class="badge bg-success">
                        Active Student
                    </span>

                </div>

                <!-- Right Side -->
                <div class="col-md-8">

                    <table class="table table-bordered">

                        <tr>
                            <th width="220">Student Code</th>
                            <td>@Model.StudentCode</td>
                        </tr>

                        <tr>
                            <th>Full Name</th>
                            <td>@Model.Name</td>
                        </tr>

                        <tr>
                            <th>Father Name</th>
                            <td>@Model.FatherName</td>
                        </tr>

                        <tr>
                            <th>Email</th>
                            <td>@Model.Email</td>
                        </tr>

                        <tr>
                            <th>Phone Number</th>
                            <td>@Model.PhoneNumber</td>
                        </tr>

                        <tr>
                            <th>Gender</th>
                            <td>@Model.Gender</td>
                        </tr>

                        <tr>
                            <th>Date of Birth</th>
                            <td>@Model.DateOfBirth.ToString("dd MMM yyyy")</td>
                        </tr>

                        <tr>
                            <th>Age</th>
                            <td>@Model.Age</td>
                        </tr>

                        <tr>
                            <th>Course</th>
                            <td>@Model.Course</td>
                        </tr>

                        <tr>
                            <th>Batch</th>
                            <td>
                                @(string.IsNullOrEmpty(Model.Batch)
                                    ? "Admin will assign"
                                    : Model.Batch)
                            </td>
                        </tr>

                        <tr>
                            <th>Section</th>
                            <td>
                                @(string.IsNullOrEmpty(Model.Section)
                                    ? "Admin will assign"
                                    : Model.Section)
                            </td>
                        </tr>

                        <tr>
                            <th>Address</th>
                            <td>@Model.Address</td>
                        </tr>

                        <tr>
                            <th>City</th>
                            <td>@Model.City</td>
                        </tr>

                        <tr>
                            <th>Registration Date</th>
                            <td>@Model.RegistrationDate.ToString("dd MMM yyyy")</td>
                        </tr>

                        <tr>
                            <th>Public Token</th>
                            <td>@Model.PublicToken</td>
                        </tr>

                    </table>
                    <hr />

                    <h4 class="mb-3">
                        Student QR Code
                    </h4>

                    <div class="row">

                        <div class="col-md-4 text-center">

                            <img src="@Url.Action("GenerateQr", "Students", new { id = Model.Id })"
                                 class="img-fluid border p-2"
                                 style="max-width:220px;" />

                        </div>

                        <div class="col-md-8">

                            <p>Scan this QR Code to view the student's public profile.</p>

                            <a asp-action="PublicProfile"
                               asp-route-token="@Model.PublicToken"
                               target="_blank"
                               class="btn btn-success">
                                🌐 Open Public Profile
                            </a>

                            <a asp-action="GenerateQr"
                               asp-route-id="@Model.Id"
                               class="btn btn-primary">
                            </a>

                        </div>

                    </div>

                    <hr />

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Back

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
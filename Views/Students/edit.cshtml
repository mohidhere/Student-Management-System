@model studentmanagement.Models.Student

@{
    ViewData["Title"] = "Edit Student";
}

<div class="card">

    <div class="card-header">
        <h3 class="card-title">Edit Student</h3>
    </div>

    <div class="card-body">

        <form asp-action="Edit" method="post" enctype="multipart/form-data">

            <!-- Hidden Fields -->
            <input asp-for="Id" type="hidden" />
            <input asp-for="ProfileImage" type="hidden" />
            <input asp-for="StudentCode" type="hidden" />
            <input asp-for="PublicToken" type="hidden" />
            <input asp-for="RegistrationDate" type="hidden" />
            <input asp-for="OtpVerified" type="hidden" id="OtpVerified" />

            <!-- Profile Picture -->
            <div class="mb-3">

                <label class="form-label">Profile Picture</label>

                <input type="file"
                       asp-for="Photo"
                       id="Photo"
                       class="form-control"
                       accept="image/*" />

                <span asp-validation-for="Photo" class="text-danger"></span>

                @if (!string.IsNullOrEmpty(Model.ProfileImage))
                {
                    <img id="previewImage"
                         src="@Model.ProfileImage"
                         class="mt-3 rounded border"
                         width="150"
                         height="150" />
                }
                else
                {
                    <img id="previewImage"
                         src="/images/default-user.png"
                         class="mt-3 rounded border"
                         width="150"
                         height="150" />
                }

            </div>

            <!-- Student Code -->
            <div class="mb-3">

                <label asp-for="StudentCode" class="form-label">
                    Student Code
                </label>

                <input asp-for="StudentCode"
                       class="form-control"
                       readonly />

            </div>

            <!-- Full Name -->
            <div class="mb-3">

                <label asp-for="Name" class="form-label">
                    Full Name
                </label>

                <input asp-for="Name"
                       class="form-control"
                       placeholder="Enter Full Name" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>

            </div>

            <!-- Father Name -->
            <div class="mb-3">

                <label asp-for="FatherName" class="form-label"></label>

                <input asp-for="FatherName"
                       class="form-control"
                       placeholder="Enter Father Name" />

                <span asp-validation-for="FatherName"
                      class="text-danger"></span>

            </div>

            <!-- Email -->
            <div class="mb-3">

                <label asp-for="Email" class="form-label"></label>

                <div class="input-group">

                    <input asp-for="Email"
                           id="email"
                           type="email"
                           class="form-control"
                           placeholder="Enter Email Address" />

                    <button type="button"
                            id="sendOtpBtn"
                            class="btn btn-primary">
                        Send OTP
                    </button>

                </div>

                <span asp-validation-for="Email"
                      class="text-danger"></span>

            </div>

            <!-- OTP -->
            <div class="mb-3">

                <label class="form-label">
                    Verification Code
                </label>

                <div class="input-group">

                    <input type="text"
                           id="otp"
                           class="form-control"
                           maxlength="6"
                           placeholder="Enter 6 Digit OTP" />

                    <button type="button"
                            id="verifyOtpBtn"
                            class="btn btn-success">
                        Verify OTP
                    </button>

                </div>

            </div>

            <!-- Phone -->
            <div class="mb-3">

                <label asp-for="PhoneNumber" class="form-label"></label>

                <input asp-for="PhoneNumber"
                       class="form-control"
                       maxlength="11"
                       placeholder="03XXXXXXXXX" />

                <span asp-validation-for="PhoneNumber"
                      class="text-danger"></span>

            </div>

            <!-- Gender -->
            <div class="mb-3">

                <label class="form-label">
                    Gender
                </label>

                <div>

                    <input asp-for="Gender"
                           type="radio"
                           value="Male"
                           class="form-check-input" />

                    <label class="form-check-label">
                        Male
                    </label>

                    <input asp-for="Gender"
                           type="radio"
                           value="Female"
                           class="form-check-input ms-3" />

                    <label class="form-check-label">
                        Female
                    </label>

                </div>

                <span asp-validation-for="Gender"
                      class="text-danger"></span>

            </div>

            <!-- DOB + Age -->
            <div class="row">

                <div class="col-md-6">

                    <div class="mb-3">

                        <label asp-for="DateOfBirth"
                               class="form-label"></label>

                        <input asp-for="DateOfBirth"
                               type="date"
                               id="dob"
                               class="form-control" />

                        <span asp-validation-for="DateOfBirth"
                              class="text-danger"></span>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="mb-3">

                        <label asp-for="Age"
                               class="form-label"></label>

                        <input asp-for="Age"
                               id="age"
                               class="form-control"
                               readonly />

                    </div>

                </div>

            </div>
            <!-- Course -->
            <div class="mb-3">

                <label asp-for="Course" class="form-label"></label>

                <input class="form-control"
                       value="@Model.Course"
                       readonly />

                <input asp-for="Course" type="hidden" />

            </div>

            <!-- Address -->
            <div class="mb-3">

                <label asp-for="Address"
                       class="form-label"></label>

                <textarea asp-for="Address"
                          class="form-control"
                          rows="3"
                          placeholder="Enter complete address"></textarea>

                <span asp-validation-for="Address"
                      class="text-danger"></span>

            </div>

            <!-- City -->
            <div class="mb-3">

                <label asp-for="City"
                       class="form-label"></label>

                <input asp-for="City"
                       class="form-control"
                       placeholder="Enter City" />

                <span asp-validation-for="City"
                      class="text-danger"></span>

            </div>

            <button id="saveBtn"
                    type="submit"
                    class="btn btn-primary"
                    disabled>

                Update Student

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Back

            </a>

        </form>

    </div>

</div>

<partial name="_ValidationScriptsPartial" />

<script src="~/js/student.js"></script>

<script>

    document.getElementById("Photo").addEventListener("change", function (event) {

        const file = event.target.files[0];

        if (file) {

            const reader = new FileReader();

            reader.onload = function (e) {

                document.getElementById("previewImage").src = e.target.result;

            }

            reader.readAsDataURL(file);

        }

    });

</script>
@model List<studentmanagement.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="card">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h3 class="card-title mb-0">
            Student List
        </h3>

        <a asp-controller="Students"
           asp-action="Create"
           class="btn btn-primary">

            <i class="ti ti-user-plus"></i>
            Add Student

        </a>

    </div>

    <div class="card-body">

        <!-- Search -->
        <form asp-action="Index" method="get" class="row mb-4">

            <div class="col-md-8">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search by Name, Email or Course..." />

            </div>

            <div class="col-md-4">

                <button type="submit" class="btn btn-primary">

                    <i class="ti ti-search"></i>
                    Search

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Reset

                </a>

            </div>

        </form>

        @if (Model != null && Model.Count > 0)
        {

            <div class="table-responsive">

                <table class="table table-bordered table-striped">
                    <thead class="table-light">

                        <tr>

                            <th>#</th>
                            <th>Photo</th>
                            <th>Student Code</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Course</th>
                            <th>Batch</th>
                            <th>Section</th>
                            <th>Age</th>
                            <th width="420">Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int count = 1;
                        }

                        @foreach (var student in Model)
                        {

                            <tr>

                                <td>@count</td>

                                <td>

                                    @if (!string.IsNullOrEmpty(student.ProfileImage))
                                    {
                                        <img src="@student.ProfileImage"
                                             class="rounded-circle border"
                                             width="55"
                                             height="55"
                                             style="object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <img src="/images/default-user.png"
                                             class="rounded-circle border"
                                             width="55"
                                             height="55"
                                             style="object-fit:cover;" />
                                    }

                                </td>

                                <td>
                                    @student.StudentCode
                                </td>

                                <td>
                                    @student.Name
                                </td>

                                <td>
                                    @student.Email
                                </td>

                                <td>
                                    @student.Course
                                </td>

                                <td>
                                    @(string.IsNullOrEmpty(student.Batch)
                                        ? "Admin will assign"
                                        : student.Batch)
                                </td>

                                <td>
                                    @(string.IsNullOrEmpty(student.Section)
                                        ? "Admin will assign"
                                        : student.Section)
                                </td>

                                <td>
                                    @student.Age
                                </td>

                                <td>
                                    <div class="d-flex flex-wrap gap-2 justify-content-center">

                                        <a asp-action="Details"
                                           asp-route-id="@student.Id"
                                           class="btn btn-info btn-sm">
                                            <i class="ti ti-eye"></i> View
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@student.Id"
                                           class="btn btn-warning btn-sm">
                                            <i class="ti ti-edit"></i> Edit
                                        </a>

                                        <a asp-action="Assign"
                                           asp-route-id="@student.Id"
                                           class="btn btn-success btn-sm">
                                            <i class="ti ti-list-check"></i> Assign
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@student.Id"
                                           class="btn btn-danger btn-sm"
                                           onclick="return confirm('Are you sure you want to delete this student?');">
                                            <i class="ti ti-trash"></i> Delete
                                        </a>

                                    </div>
                                </td>
                            </tr>

                            count++;

                        }

                    </tbody>

                </table>

            </div>

        }
        else
        {

            <div class="alert alert-warning">

                <i class="ti ti-alert-circle"></i>

                No students found.

            </div>

        }

    </div>

</div>